# SQLite by default (zero setup). For a real deployment (e.g. Vercel),
# SQLite's local file won't persist across serverless invocations — point
# this at a Postgres database instead (e.g. a Supabase or Neon connection
# string) and change the `provider` in prisma/schema.prisma to
# "postgresql" before you deploy.
DATABASE_URL="file:./dev.db"

# Random 32+ char secret used to sign CRM login session cookies.
# Generate one with: openssl rand -hex 32
CRM_SESSION_SECRET=

# Default password for the three seeded partner accounts (Unais, Jamal,
# Sazid). Change this after first login — see Settings → Change My Password.
CRM_SEED_PASSWORD=ChangeMe123!

# --- Optional integrations (the CRM works fully without these; features
# that need them show a "configure in Settings" state until set) ---

# SMTP, for emailing contract signing links and invoice notifications.
CRM_SMTP_HOST=
CRM_SMTP_PORT=
CRM_SMTP_USER=
CRM_SMTP_PASS=
CRM_SMTP_FROM=

# RSS feed URL for the Overview "industry news" panel.
CRM_NEWS_RSS_URL=https://www.marketingweek.com/feed/
